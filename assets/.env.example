# Copy to .env.local (gitignored) and fill in. Commit THIS file with empty values.
#
# Never paste a real key into a chat message. Create the key in the service's
# dashboard, write it in yourself, and let tooling read it from the environment.
# Production values belong in the host dashboard (Vercel/Netlify), not in the repo.

# ── Site ───────────────────────────────────────────────────────────────────
# Must match `site` in astro.config.mjs and the live domain exactly.
PUBLIC_SITE_URL=

# ── Plausible Analytics ────────────────────────────────────────────────────
# data-domain value — the live domain without protocol, e.g. example.com
PUBLIC_PLAUSIBLE_DOMAIN=
# Stats API: Plausible → Account settings → API keys
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=

# ── Google Search Console ──────────────────────────────────────────────────
# Absolute path to the service-account JSON, stored OUTSIDE the repo (chmod 600)
GOOGLE_APPLICATION_CREDENTIALS=
# Domain property: sc-domain:example.com   URL-prefix property: https://example.com/
GSC_PROPERTY=

# ── Supabase (delete if unused) ────────────────────────────────────────────
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security — never expose to the browser,
# never prefix with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Image CDN (delete if unused) ───────────────────────────────────────────
PUBLIC_CLOUDINARY_CLOUD_NAME=
